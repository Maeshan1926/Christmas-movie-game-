# Copy to .env for local development (never commit .env).
# Private code the family types once per device.
FAMILY_CODE=choose-a-long-family-passphrase
# https://www.themoviedb.org/settings/api  (free). Use either one.
TMDB_API_KEY=
TMDB_READ_TOKEN=
# Supabase > Project Settings > API. The service role key stays server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
